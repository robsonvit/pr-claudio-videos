# Chaves de API - NAO versionar este arquivo!
# Copie este arquivo para .env e preencha os valores

# OpenRouter (geracao de roteiro)
OPENROUTER_API_KEY=

# Pexels (busca de videos de fundo)
PEXELS_API_KEY=

# Telegram (notificacoes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube OAuth 2.0 (canal JESUS VIVE)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Fish Audio (TTS - voz Pr. Claudio / Jesus)
FISH_API_KEY=

# Facebook Meta API (Pagina: Enfermagem Curiosa)
META_FB_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_USER_ACCESS_TOKEN=